---
import BaseLayout from "@determinant/site-kit/layouts/BaseLayout.astro";
import LaceOfferingShell from "@determinant/site-kit/components/lace/LaceOfferingShell.astro";
import { createLaceApplicationJsonLd, laceSite } from "../../site.config";

const content = {
  kicker: "Applications · LACE-GOV",
  title: "Standards-conformant AI for the mission boundary.",
  accent: "for the mission boundary.",
  lead:
    "LACE-GOV is the platform packaged for federal, defense, and intelligence programs: BFO/CCO-conformant schema packs, cross-enclave federated discovery without data movement, air-gapped deployment with no external model calls, and accreditation evidence you can export as artifacts.",
  points: [
    {
      title: "Air-gapped AI deployment",
      detail:
        "Runs fully disconnected on your hardware, in your enclave, with open-weight models served locally. No inference call, telemetry beacon, or model-update check ever leaves the boundary — the same platform, minus the internet.",
    },
    {
      title: "BFO and CCO ontology conformance",
      detail:
        "Schema packs align to the Basic Formal Ontology and the Common Core Ontologies, so the knowledge graph you build is interoperable with the semantic standards federal programs increasingly mandate — rather than a bespoke model nobody else can read.",
    },
    {
      title: "Cross-enclave federated search",
      detail:
        "Query across enclaves and classification boundaries without moving the underlying data. Each side answers from its own store under its own access rules; only permitted results cross, and every crossing is logged.",
    },
    {
      title: "Accreditation evidence as an export",
      detail:
        "Lineage, access enforcement records, and standards-conformance reports come out as artifacts your ATO package can cite — because they are generated by the running system, not reconstructed by hand at assessment time.",
    },
    {
      title: "Permissions enforced at retrieval",
      detail:
        "Clearance and need-to-know are evaluated when a document is retrieved, not after a model has already read it. An agent cannot cite what the requesting person is not cleared to see.",
    },
    {
      title: "RFP and compliance drafting",
      detail:
        "Grounded drafting over your past-performance library, governing regulations, and prior submissions — each claim traceable to the source document and paragraph it came from.",
    },
  ],
  practice:
    "An analyst asks a question spanning two enclaves. LACE-GOV federates the query, each enclave answers from its own index under its own access rules, and the response returns with per-fact citations and a record of exactly which sources were reached, by whom, and under what authority — the whole chain available later as accreditation evidence.",
  deepTitle: "Built for the constraints the mission actually has.",
  deepAccent: "the mission actually has.",
  deep: [
    {
      title: "No external AI calls, by construction",
      detail:
        "Air-gapped mode is not a configuration flag over a cloud product. Model serving, embedding, indexing, and orchestration all run inside the boundary, so there is no code path that requires an outbound connection to function.",
    },
    {
      title: "Provenance that survives audit",
      detail:
        "Every fact in the knowledge graph is linked to the document, version, and location it was extracted from, with the time it was asserted and the time it was believed true. Point-in-time queries answer what the system knew on a given date — the question investigations actually ask.",
    },
    {
      title: "Standards packs, not consulting engagements",
      detail:
        "BFO/CCO alignment ships as versioned schema packs that upgrade with the platform. Conformance is checked continuously rather than certified once and drifting thereafter.",
    },
  ],
  related: [
    { href: "/applications/lace-legal", title: "LACE Legal", line: "Contracts with the receipts." },
    { href: "/applications/lace-finance", title: "LACE Finance", line: "Every figure traced." },
    { href: "/platform/knowledge-graph", title: "Knowledge Graph", line: "Every fact receipted." },
  ],
  ctaTitle: "Bring governed AI inside the boundary.",
  ctaAccent: "inside the boundary.",
  faqs: [
    {
      q: "Can LACE run fully air-gapped with no internet connection?",
      a: "Yes. LACE-GOV deploys entirely within your enclave on your hardware, serving open-weight models locally. Inference, embedding, indexing, and orchestration all run inside the boundary, and no component requires an outbound connection — including model updates, which are applied from media you control.",
    },
    {
      q: "What is BFO/CCO conformance and why does it matter for federal AI?",
      a: "The Basic Formal Ontology (BFO) is an ISO/IEC 21838-2 upper ontology, and the Common Core Ontologies (CCO) extend it with mid-level classes for people, organizations, events, and artifacts. Federal programs increasingly require this alignment so knowledge assets remain interoperable across systems and vendors. LACE-GOV ships schema packs aligned to both and checks conformance continuously.",
    },
    {
      q: "How does cross-enclave federation work without moving data?",
      a: "Each enclave runs its own LACE index and answers queries locally under its own access policy. The federating query returns only results the requester is permitted to receive, and every cross-boundary request and response is recorded. The underlying documents never leave their enclave.",
    },
    {
      q: "What accreditation evidence can LACE-GOV produce?",
      a: "Data lineage for every indexed and extracted fact, access-enforcement logs showing which identities retrieved what and under which policy, agent execution traces, and standards-conformance reports. These are exported as artifacts that an ATO or assessment package can reference directly.",
    },
    {
      q: "Which classification levels and deployment models are supported?",
      a: "LACE-GOV is deployed as customer-operated software in the environment you designate — commercial cloud, government cloud, private cloud, on-premises, or fully disconnected. Accreditation is program-specific; the platform supplies the enforcement and evidence, and the authorizing official retains the boundary.",
    },
  ],
};

const pageDescription =
  "LACE-GOV is a governed AI platform for federal, defense, and intelligence programs: air-gapped deployment, BFO/CCO-conformant ontologies, cross-enclave federated search, and exportable accreditation evidence.";
---

<BaseLayout
  title={`LACE-GOV — Air-Gapped Federal & Defense AI Platform | ${laceSite.name}`}
  description={pageDescription}
  theme="lace"
  themeColor="#f6f7f9"
  lang="en"
  siteName={laceSite.name}
  imageAlt="LACE-GOV governed AI platform for federal, defense, and intelligence programs"
  jsonLd={createLaceApplicationJsonLd({
    path: "/applications/lace-gov",
    name: "LACE-GOV",
    description: pageDescription,
    audience: "Federal, Defense, and Intelligence",
    faqs: content.faqs,
  })}
>
  <LaceOfferingShell {...content} />
</BaseLayout>
