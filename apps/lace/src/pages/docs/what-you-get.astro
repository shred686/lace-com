const codeManifestJson = `{
  <span class="tk-s">"app_id"</span>: <span class="tk-s">"acme.field_intake"</span>,
  <span class="tk-s">"display_name"</span>: <span class="tk-s">"Field Intake"</span>,
  <span class="tk-s">"version"</span>: <span class="tk-s">"0.1.0"</span>,
  <span class="tk-s">"data_collections"</span>: [ ... ],
  <span class="tk-s">"route_providers"</span>: [<span class="tk-s">"app.routes:RouteProvider"</span>],
  <span class="tk-s">"agent_providers"</span>: [<span class="tk-s">"app.agents:AgentProvider"</span>],
  <span class="tk-s">"tool_modules"</span>: [<span class="tk-s">"app.tools"</span>],
  <span class="tk-s">"migration_provider"</span>: <span class="tk-s">"app.migrations:Migrations"</span>
