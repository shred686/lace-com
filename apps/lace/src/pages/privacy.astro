---
import BaseLayout from "@determinant/site-kit/layouts/BaseLayout.astro";
import LaceNav from "@determinant/site-kit/components/lace/LaceNav.astro";
import LaceFooter from "@determinant/site-kit/components/lace/LaceFooter.astro";
import "@determinant/site-kit/styles/lace-site.css";
import { PRIVACY_POLICY_BODY_HTML } from "@determinant/site-kit/legal/privacy-policy-content";
import { laceSite } from "../site.config";
---

<BaseLayout
  title={`Privacy Policy | ${laceSite.name}`}
  description={`How Determinant Systems, Inc. collects, uses, and protects personal information across ${laceSite.name} and its services.`}
  theme="lace"
  themeColor="#f6f7f9"
  lang="en"
  siteName={laceSite.name}
  imageAlt="LACE privacy policy"
>
  <main id="lp-main" class="lp-site lp-legal">
    <LaceNav />

    <section class="lp-legal-shell">
      <div class="lp-wrap">
        <p class="lp-kicker">Legal</p>
        <div class="legal-doc" set:html={PRIVACY_POLICY_BODY_HTML} />
      </div>
    </section>

    <LaceFooter />
  </main>
</BaseLayout>

<style>
  .lp-legal-shell {
    padding: clamp(8.5rem, 15vh, 11rem) 0 clamp(4rem, 8vw, 6rem);
  }

  .lp-legal-shell .lp-kicker {
    margin-bottom: 1rem;
  }

  .legal-doc {
    max-width: 780px;
  }
</style>

<style is:global>
  /* Termly's export ships every color inline, which fights the site's own
     type system. `!important` here beats those inline (non-!important)
     styles without touching the source content. */
  .legal-doc,
  .legal-doc div,
  .legal-doc span,
  .legal-doc li,
  .legal-doc td,
  .legal-doc th,
  .legal-doc strong,
  .legal-doc em,
  .legal-doc u {
    font-family: "Space Grotesk", "Red Hat Display", sans-serif !important;
    font-size: 0.94rem !important;
    line-height: 1.7 !important;
    color: var(--lp-ink-soft) !important;
  }

  .legal-doc > div {
    margin: 0 0 0.9rem;
  }

  .legal-doc h1,
  .legal-doc h2,
  .legal-doc h3 {
    font-family: "Space Grotesk", "JetBrains Mono", monospace !important;
    color: var(--lp-ink) !important;
    text-transform: none !important;
    letter-spacing: -0.01em !important;
  }

  .legal-doc h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.8rem, 3.4vw, 2.5rem) !important;
    font-weight: 600 !important;
    line-height: 1.1 !important;
  }

  .legal-doc h2 {
    margin: 2.4rem 0 0.6rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--lp-line);
    font-size: 1.3rem !important;
    font-weight: 600 !important;
    line-height: 1.25 !important;
  }

  .legal-doc h3 {
    margin: 1.6rem 0 0.5rem;
    font-size: 1.05rem !important;
    font-weight: 600 !important;
    line-height: 1.3 !important;
  }

  .legal-doc [data-custom-class="subtitle"] {
    color: var(--lp-muted) !important;
    font-size: 0.82rem !important;
    text-transform: none;
  }

  .legal-doc a {
    color: var(--lp-green-deep) !important;
    text-decoration: underline;
    text-decoration-color: rgba(var(--lp-green-rgb), 0.4);
    text-underline-offset: 2px;
  }

  .legal-doc a:hover {
    text-decoration-color: currentColor;
  }

  .legal-doc ul {
    margin: 0 0 0.9rem;
    padding-left: 1.3rem;
    list-style: disc;
  }

  .legal-doc li {
    margin: 0 0 0.5rem !important;
  }

  .legal-doc table {
    width: 100%;
    margin: 0.5rem 0 1.2rem;
    border-collapse: collapse;
    font-size: 0.82rem !important;
  }

  .legal-doc table * {
    font-size: 0.82rem !important;
  }

  .legal-doc th,
  .legal-doc td {
    padding: 0.6rem 0.8rem !important;
    text-align: left;
    vertical-align: top;
    border: 1px solid var(--lp-line) !important;
  }

  .legal-doc th {
    background: rgba(13, 27, 22, 0.03);
    font-weight: 700 !important;
  }

  .legal-doc div:has(> table) {
    overflow-x: auto;
  }
</style>
