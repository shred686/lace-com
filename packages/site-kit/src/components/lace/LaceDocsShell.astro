---
/**
 * laceplatform.com/docs/* — documentation shell (Mintlify-style).
 * Own header (search, GitHub, version selectors), left sidebar nav with live
 * filter, prose content column, right "On this page" rail, and prev/next.
 * Namespace: lpd-* (docs shell) on top of the lp-* tokens.
 *
 * One instance per docs route. The sidebar's active state is server-rendered
 * from `slug` rather than scroll-spied, because each section is now its own
 * URL instead of an anchor on a single page.
 */
import "../../styles/lace-site.css";
import {
  docsNav,
  docsHref,
  docsTabs,
  docsTabForSlug,
  docsPrevNext,
} from "../../data/laceDocsNav";

interface Props {
  /** Route slug this page renders; "" is the /docs index. */
  slug: string;
  /** Crumb shown above the page heading. Defaults to the containing group. */
  crumb?: string;
}

const { slug, crumb } = Astro.props;

const activeTab = docsTabForSlug(slug);
const { prev, next } = docsPrevNext(slug);
const resolvedCrumb =
  crumb ?? docsNav.find((group) => group.items.some((item) => item.slug === slug))?.group ?? "Docs";
---

<div class="lpd">
  <a class="lp-skip" href="#lp-main">Skip to content</a>

  <!-- ── Docs header ──────────────────────────────────────────────── -->
  <header class="lpd-header">
    <div class="lpd-header-row">
      <a href="/" class="lpd-brand" aria-label="LACE home">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="3" fill="#00A882"></circle>
          <circle cx="9" cy="9" r="6.5" stroke="#00A882" stroke-width="0.7" opacity="0.5"></circle>
        </svg>
        <span>LACE</span>
      </a>

      <div class="lpd-select" data-select>
        <button type="button" aria-haspopup="listbox" aria-expanded="false">
          <span data-select-label>v0.1</span>
          <svg width="9" height="9" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2 3.5 5 6.5 8 3.5" stroke="currentColor" stroke-width="1.4"></path>
          </svg>
        </button>
        <ul role="listbox" aria-label="SDK version">
          <li role="option" aria-selected="true" data-value="v0.1">v0.1 <i>Current</i></li>
        </ul>
      </div>

      <div class="lpd-select" data-select>
        <button type="button" aria-haspopup="listbox" aria-expanded="false">
          <span data-select-label>Python</span>
          <svg width="9" height="9" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2 3.5 5 6.5 8 3.5" stroke="currentColor" stroke-width="1.4"></path>
          </svg>
        </button>
        <ul role="listbox" aria-label="SDK language">
          <li role="option" aria-selected="true" data-value="Python">Python</li>
          <li role="option" aria-disabled="true">TypeScript <i>Soon</i></li>
        </ul>
      </div>

      <label class="lpd-search">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="1.6"></path>
        </svg>
        <input type="search" placeholder="Search docs…" data-docs-search autocomplete="off" />
        <kbd>Ctrl K</kbd>
      </label>

      <div class="lpd-header-actions">
        <a
          href="https://github.com/Determinant-Systems"
          target="_blank"
          rel="noopener noreferrer"
          class="lpd-gh"
          aria-label="GitHub"
        >
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          <span>GitHub</span>
        </a>
        <a href="/contact" class="lpd-cta">Book a demo</a>
      </div>
    </div>

    <nav class="lpd-tabs" aria-label="Docs sections">
      {
        docsTabs.map((tab) => (
          <a href={tab.href} class={tab.tab === activeTab ? "is-active" : undefined}>
            {tab.tab}
          </a>
        ))
      }
      <a href="/blog">Blog</a>
      <a href="/">laceplatform.com ↗</a>
    </nav>
  </header>

  <!-- ── Body: sidebar / content / toc ────────────────────────────── -->
  <div class="lpd-body">
    <aside class="lpd-side" aria-label="Docs navigation">
      {/* On one column the sidebar is ~900px of links standing between the
          reader and the first heading, so below 880px it collapses behind
          this summary. Open by default; the script closes it on narrow
          viewports, which also keeps it open when JS never runs. */}
      <details class="lpd-side-acc" data-side-acc open>
        <summary>Documentation menu<i aria-hidden="true">+</i></summary>
      <div class="lpd-side-quick">
        <a href="/platform/enterprise-search">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="1.6"/></svg>
          Platform site
        </a>
        <a href="/blog">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 3.5h14v17H5z" stroke="currentColor" stroke-width="1.5"/><path d="M8.5 8h7M8.5 11.5h7M8.5 15h4.5" stroke="currentColor" stroke-width="1.5"/></svg>
          Blog
        </a>
        <a href="/contact">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7.5A1.5 1.5 0 0 1 5.5 6h13A1.5 1.5 0 0 1 20 7.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 16.5v-9Z" stroke="currentColor" stroke-width="1.5"/><path d="m5 8 7 5 7-5" stroke="currentColor" stroke-width="1.5"/></svg>
          Support
        </a>
      </div>

      {
        docsNav.map((section) => (
          <div class="lpd-side-group" data-side-group>
            <p>{section.group}</p>
            {section.items.map((item) => (
              <a
                href={docsHref(item.slug)}
                data-side-link
                class={item.slug === slug ? "is-active" : undefined}
                aria-current={item.slug === slug ? "page" : undefined}
              >
                {item.label}
              </a>
            ))}
          </div>
        ))
      }
      <p class="lpd-side-empty" data-side-empty hidden>No matches.</p>
      </details>
    </aside>

    <main id="lp-main" class="lpd-main">
      <p class="lpd-crumb">{resolvedCrumb}</p>
      <slot />

      <nav class="lpd-pager" aria-label="Docs pagination">
        {
          prev ? (
            <a href={docsHref(prev.slug)} class="lpd-pager-link" rel="prev">
              <span>← Previous</span>
              <strong>{prev.label}</strong>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={docsHref(next.slug)} class="lpd-pager-link lpd-pager-next" rel="next">
              <span>Next →</span>
              <strong>{next.label}</strong>
            </a>
          )
        }
      </nav>

      <footer class="lpd-foot">
        <p>© {new Date().getFullYear()} LACE · A Determinant Systems product</p>
        <a href="/">← Back to laceplatform.com</a>
      </footer>
    </main>

    <aside class="lpd-toc" aria-label="On this page">
      <p>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6.5h10M4 12h16M4 17.5h13" stroke="currentColor" stroke-width="1.6"/></svg>
        On this page
      </p>
      <div class="lpd-toc-list" data-toc-list></div>

      <div class="lpd-promo">
        <strong>Ready to build?</strong>
        <span>Get SDK access and a working example on your tenant.</span>
        <a href="/contact" class="lpd-cta lpd-promo-cta">Book a demo</a>
        <a href="/pricing" class="lpd-promo-link">See pricing →</a>
      </div>
    </aside>
  </div>
</div>

<style is:global>
  /* Docs shell — global styles under the .lpd namespace (single page). */
  .lpd {
    --lpd-header-h: 6.4rem;
    min-height: 100vh;
    background: #fdfdfe;
    color: var(--lp-ink);
  }

  /* ── Header ───────────────────────────────────────────────────── */
  .lpd-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    background: rgba(253, 253, 254, 0.94);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--lp-line-soft);
  }

  .lpd-header-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: min(1460px, calc(100% - 3rem));
    margin-inline: auto;
    padding: 0.8rem 0;
  }

  .lpd-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    font-family: "Space Grotesk", "JetBrains Mono", monospace;
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--lp-ink);
  }

  /* Shared dropdown selector (version + language) */
  .lpd-select {
    position: relative;
  }

  .lpd-select > button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.38rem 0.65rem;
    border: 1px solid var(--lp-line);
    border-radius: var(--lp-radius);
    background: #ffffff;
    cursor: pointer;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.62rem;
    color: var(--lp-ink-soft);
    transition: border-color 150ms ease, color 150ms ease;
  }

  .lpd-select > button:hover,
  .lpd-select.is-open > button {
    border-color: rgba(var(--lp-green-rgb), 0.5);
    color: var(--lp-green-deep);
  }

  .lpd-select > button svg {
    transition: transform 200ms ease;
    color: var(--lp-faint);
  }

  .lpd-select.is-open > button svg {
    transform: rotate(180deg);
  }

  .lpd-select > ul {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    z-index: 70;
    min-width: 100%;
    margin: 0;
    padding: 0.3rem;
    list-style: none;
    background: #ffffff;
    border: 1px solid var(--lp-line);
    border-radius: var(--lp-radius-lg);
    box-shadow: var(--lp-shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 180ms ease, transform 180ms ease, visibility 0s linear 180ms;
  }

  .lpd-select.is-open > ul {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0s;
  }

  .lpd-select li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.42rem 0.6rem;
    border-radius: var(--lp-radius);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.64rem;
    color: var(--lp-ink-soft);
    cursor: pointer;
    white-space: nowrap;
  }

  .lpd-select li:hover {
    background: rgba(var(--lp-green-rgb), 0.07);
  }

  .lpd-select li[aria-selected="true"] {
    color: var(--lp-green-deep);
    font-weight: 700;
  }

  .lpd-select li[aria-disabled="true"] {
    color: var(--lp-faint);
    cursor: not-allowed;
  }

  .lpd-select li i {
    margin-left: auto;
    font-style: normal;
    padding: 0.1rem 0.4rem;
    border-radius: var(--lp-radius);
    background: rgba(var(--lp-green-rgb), 0.1);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lp-green-deep);
  }

  .lpd-select li[aria-disabled="true"] i {
    background: rgba(13, 27, 22, 0.05);
    color: var(--lp-faint);
  }

  .lpd-search {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 30rem;
    margin-inline: auto;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--lp-line);
    border-radius: var(--lp-radius-lg);
    background: #f5f6f8;
    color: var(--lp-faint);
    cursor: text;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .lpd-search:focus-within {
    border-color: rgba(var(--lp-green-rgb), 0.55);
    box-shadow: 0 0 0 3px rgba(var(--lp-green-rgb), 0.12);
  }

  .lpd-search svg {
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
  }

  .lpd-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.84rem;
    color: var(--lp-ink);
    outline: none;
  }

  .lpd-search kbd {
    flex: none;
    padding: 0.16rem 0.45rem;
    border: 1px solid var(--lp-line);
    border-radius: var(--lp-radius);
    background: #ffffff;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.58rem;
    color: var(--lp-faint);
  }

  .lpd-header-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .lpd-gh {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    gap: 0.45rem;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--lp-ink-soft);
  }

  .lpd-gh:hover {
    color: var(--lp-green-deep);
  }

  .lpd-gh svg {
    width: 1rem;
    height: 1rem;
  }

  .lpd-cta {
    padding: 0.5rem 1rem;
    border-radius: var(--lp-radius);
    background: linear-gradient(135deg, #00b88d, #00d9ae);
    color: var(--lp-green-ink);
    text-decoration: none;
    font-family: "Space Grotesk", "JetBrains Mono", monospace;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background 160ms ease, color 160ms ease;
  }

  .lpd-cta:hover {
    background: var(--lp-ink);
    color: #fff;
  }

  .lpd-tabs {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    width: min(1460px, calc(100% - 3rem));
    margin-inline: auto;
    padding: 0.1rem 0 0;
    overflow-x: auto;
  }

  .lpd-tabs a {
    padding: 0.55rem 0 0.7rem;
    border-bottom: 2px solid transparent;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--lp-muted);
    white-space: nowrap;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .lpd-tabs a:hover {
    color: var(--lp-ink);
  }

  .lpd-tabs a.is-active {
    color: var(--lp-ink);
    border-bottom-color: var(--lp-green);
  }

  /* ── Body grid ────────────────────────────────────────────────── */
  .lpd-body {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr) 240px;
    gap: clamp(1.5rem, 3vw, 3.5rem);
    width: min(1460px, calc(100% - 3rem));
    margin-inline: auto;
    padding-top: var(--lpd-header-h);
  }

  /* ── Sidebar ──────────────────────────────────────────────────── */
  .lpd-side {
    position: sticky;
    top: var(--lpd-header-h);
    height: calc(100vh - var(--lpd-header-h));
    overflow-y: auto;
    padding: 1.6rem 0.8rem 2.5rem 0;
    border-right: 1px solid var(--lp-line-soft);
  }

  .lpd-side-quick {
    display: grid;
    gap: 0.15rem;
    margin-bottom: 1.4rem;
  }

  .lpd-side-quick a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.42rem 0.6rem;
    border-radius: var(--lp-radius);
    text-decoration: none;
    font-size: 0.82rem;
    color: var(--lp-ink-soft);
  }

  .lpd-side-quick a:hover {
    background: rgba(var(--lp-green-rgb), 0.06);
    color: var(--lp-green-deep);
  }

  .lpd-side-quick svg {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--lp-faint);
  }

  .lpd-side-group {
    margin-bottom: 1.5rem;
  }

  .lpd-side-group > p {
    margin: 0 0 0.4rem;
    padding: 0 0.6rem;
    font-family: "Space Grotesk", "JetBrains Mono", monospace;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lp-ink);
  }

  .lpd-side-group a {
    display: block;
    padding: 0.38rem 0.6rem;
    border-radius: var(--lp-radius);
    text-decoration: none;
    font-size: 0.82rem;
    color: var(--lp-muted);
    transition: background 140ms ease, color 140ms ease;
  }

  .lpd-side-group a:hover {
    color: var(--lp-ink);
    background: rgba(13, 27, 22, 0.04);
  }

  .lpd-side-group a.is-active {
    background: rgba(var(--lp-green-rgb), 0.1);
    color: var(--lp-green-deep);
    font-weight: 600;
  }

  .lpd-side-empty {
    padding: 0 0.6rem;
    font-size: 0.8rem;
    color: var(--lp-faint);
  }

  /* ── Main content ─────────────────────────────────────────────── */
  .lpd-main {
    max-width: 760px;
    padding: 2rem 0 4rem;
    min-width: 0;
  }

  /* Content is now flat prose per route rather than stacked `.lpd-sec` blocks,
     so the headings themselves carry the rhythm and the anchor offset. */
  .lpd-main h2,
  .lpd-main h3 {
    scroll-margin-top: calc(var(--lpd-header-h) + 0.8rem);
  }

  .lpd-main h2:not(:first-of-type) {
    margin-top: 2.6rem;
  }

  .lpd-main h3 {
    margin-top: 2rem;
  }

  .lpd-crumb {
    margin: 0 0 0.5rem;
    font-family: "Space Grotesk", "JetBrains Mono", monospace;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lp-green-deep);
  }

  .lpd-main h1 {
    margin: 0 0 0.8rem;
    font-family: "Space Grotesk", "JetBrains Mono", monospace;
    font-size: clamp(1.7rem, 2.8vw, 2.3rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--lp-ink);
    text-transform: none;
  }

  .lpd-main h2 {
    margin: 0 0 0.7rem;
    padding-top: 0.4rem;
    font-family: "Space Grotesk", "JetBrains Mono", monospace;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--lp-ink);
    text-transform: none;
  }

  .lpd-main h3 {
    margin: 0 0 0.7rem;
    padding-top: 0.4rem;
    font-family: "Space Grotesk", "JetBrains Mono", monospace;
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--lp-ink);
    text-transform: none;
  }

  .lpd-sub {
    margin: 0 0 1.2rem;
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--lp-muted);
  }

  .lpd-main p {
    margin: 0 0 1rem;
    font-size: 0.92rem;
    line-height: 1.75;
    color: var(--lp-ink-soft);
  }

  .lpd-main ul {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
    color: var(--lp-ink-soft);
  }

  .lpd-main li {
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .lpd-main li strong,
  .lpd-main p strong {
    color: var(--lp-ink);
    font-weight: 600;
  }

  .lpd-main .lp-code {
    margin: 1.1rem 0 1.4rem;
  }

  .lpd-callout {
    display: flex;
    gap: 0.8rem;
    margin: 1.2rem 0;
    padding: 0.95rem 1.1rem;
    border: 1px solid rgba(var(--lp-green-rgb), 0.3);
    border-radius: var(--lp-radius-lg);
    background: rgba(var(--lp-green-rgb), 0.05);
  }

  .lpd-callout svg {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.15rem;
    color: var(--lp-green-deep);
  }

  .lpd-callout p {
    margin: 0;
    font-size: 0.87rem;
  }

  .lpd-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 1.4rem;
  }

  .lpd-card {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--lp-line);
    border-radius: var(--lp-radius-lg);
    background: #ffffff;
    text-decoration: none;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .lpd-card:hover {
    border-color: rgba(var(--lp-green-rgb), 0.45);
    box-shadow: var(--lp-shadow-sm);
  }

  .lpd-card strong {
    font-family: "Space Grotesk", "JetBrains Mono", monospace;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--lp-ink);
  }

  .lpd-card span {
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--lp-muted);
  }

  .lpd-table-wrap {
    margin: 1.1rem 0 1.3rem;
    overflow-x: auto;
    border: 1px solid var(--lp-line);
    border-radius: var(--lp-radius-lg);
  }

  .lpd-table-wrap table {
    width: 100%;
    min-width: 540px;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .lpd-table-wrap th {
    padding: 0.7rem 1rem;
    text-align: left;
    font-family: "Space Grotesk", "JetBrains Mono", monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lp-faint);
    background: rgba(13, 27, 22, 0.025);
    border-bottom: 1px solid var(--lp-line);
  }

  .lpd-table-wrap td {
    padding: 0.7rem 1rem;
    vertical-align: top;
    border-bottom: 1px solid var(--lp-line-soft);
    color: var(--lp-ink-soft);
    line-height: 1.6;
  }

  .lpd-table-wrap tr:last-child td {
    border-bottom: 0;
  }

  .lpd-note {
    font-size: 0.84rem;
    color: var(--lp-muted);
  }

  .lpd-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--lp-line-soft);
  }

  .lpd-foot p {
    margin: 0;
    font-size: 0.78rem;
    color: var(--lp-faint);
  }

  .lpd-foot a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-size: 0.82rem;
    color: var(--lp-green-deep);
    text-decoration: none;
  }

  /* ── Right TOC ────────────────────────────────────────────────── */
  .lpd-toc {
    position: sticky;
    top: var(--lpd-header-h);
    height: calc(100vh - var(--lpd-header-h));
    overflow-y: auto;
    padding: 1.8rem 0 2.5rem;
  }

  .lpd-toc > p {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.7rem;
    font-family: "Space Grotesk", "JetBrains Mono", monospace;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lp-ink);
  }

  .lpd-toc > p svg {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--lp-faint);
  }

  /* The rail's links are generated from the page's headings at runtime, so they
     live inside .lpd-toc-list rather than being direct children of the aside. */
  .lpd-toc-list a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.75rem;
    border-left: 2px solid var(--lp-line-soft);
    text-decoration: none;
    font-size: 0.8rem;
    color: var(--lp-muted);
    transition: color 140ms ease, border-color 140ms ease;
  }

  .lpd-toc-list a:hover {
    color: var(--lp-ink);
  }

  .lpd-toc-list a.is-active {
    border-left-color: var(--lp-green);
    color: var(--lp-green-deep);
    font-weight: 600;
  }

  .lpd-toc-list a.lpd-toc-sub {
    padding-left: 1.5rem;
    font-size: 0.76rem;
  }

  .lpd-promo {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.6rem;
    padding: 1.1rem 1.15rem 1.2rem;
    border: 1px solid rgba(var(--lp-green-rgb), 0.3);
    border-radius: var(--lp-radius-lg);
    background:
      radial-gradient(16rem 8rem at 100% 0%, rgba(var(--lp-green-rgb), 0.1), transparent 65%),
      #ffffff;
  }

  .lpd-promo strong {
    font-family: "Space Grotesk", "JetBrains Mono", monospace;
    font-size: 0.9rem;
    color: var(--lp-ink);
  }

  .lpd-promo span {
    font-size: 0.76rem;
    line-height: 1.55;
    color: var(--lp-muted);
  }

  .lpd-promo-cta {
    margin-top: 0.4rem;
    text-align: center;
  }

  .lpd-promo-link {
    text-align: center;
    font-size: 0.76rem;
    color: var(--lp-green-deep);
    text-decoration: none;
  }

  /* ── Responsive ───────────────────────────────────────────────── */
  @media (max-width: 1180px) {
    .lpd-body {
      grid-template-columns: 240px minmax(0, 1fr);
    }

    .lpd-toc {
      display: none;
    }
  }

  /* Always open on the two-column layout; the summary only exists for the
     stacked one. */
  .lpd-side-acc > summary {
    display: none;
  }

  @media (max-width: 880px) {
    .lpd {
      --lpd-header-h: 8.6rem;
    }

    .lpd-side-acc > summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 44px;
      padding: 0.2rem 0.6rem;
      list-style: none;
      cursor: pointer;
      font-family: "Space Grotesk", "JetBrains Mono", monospace;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--lp-ink);
    }

    .lpd-side-acc > summary::-webkit-details-marker {
      display: none;
    }

    .lpd-side-acc > summary i {
      font-style: normal;
      font-size: 1rem;
      line-height: 1;
      color: var(--lp-green-deep);
      transition: transform 180ms ease;
    }

    .lpd-side-acc[open] > summary i {
      transform: rotate(45deg);
    }

    .lpd-side-acc[open] {
      padding-bottom: 0.8rem;
    }

    .lpd-side-quick {
      margin-top: 0.9rem;
    }

    .lpd-side-quick a,
    .lpd-side-group a {
      display: flex;
      align-items: center;
      min-height: 40px;
    }

    /* iOS zooms the page on any field under 16px. */
    .lpd-search input {
      font-size: 16px;
    }

    .lpd-header-row {
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    .lpd-search {
      order: 10;
      flex-basis: 100%;
      max-width: none;
    }

    .lpd-select,
    .lpd-gh span {
      display: none;
    }

    .lpd-body {
      grid-template-columns: 1fr;
      padding-top: calc(var(--lpd-header-h) + 0.5rem);
    }

    .lpd-side {
      position: static;
      height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--lp-line-soft);
      /* Collapsed, this is one 44px row — the desktop 1.6/2.5rem column
         padding around it reads as a hole. */
      padding: 0.5rem 0 0.9rem;
    }

    .lpd-main {
      padding-top: 1.2rem;
    }
  }
</style>

<style is:global>
  /* Prev/next pager — added when the docs became multi-page. */
  .lpd-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.8rem;
    border-top: 1px solid var(--lp-line);
  }

  .lpd-pager-link {
    display: grid;
    gap: 0.35rem;
    padding: 0.95rem 1.1rem;
    border: 1px solid var(--lp-line);
    border-radius: var(--lp-radius);
    background: #fff;
    text-decoration: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .lpd-pager-link:hover {
    border-color: rgba(var(--lp-green-rgb), 0.45);
    box-shadow: var(--lp-shadow-sm);
  }

  .lpd-pager-next {
    grid-column: 2;
    text-align: right;
  }

  .lpd-pager-link span {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lp-faint);
  }

  .lpd-pager-link strong {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--lp-ink);
  }

  @media (max-width: 620px) {
    .lpd-pager {
      grid-template-columns: 1fr;
    }

    .lpd-pager-next {
      grid-column: 1;
      text-align: left;
    }
  }
</style>

<script>
  // ── Header dropdown selectors (version / language) ──────────────
  (() => {
    const selects = Array.from(document.querySelectorAll<HTMLElement>("[data-select]"));
    if (!selects.length) return;

    const closeAll = (except?: HTMLElement) => {
      selects.forEach((select) => {
        if (select !== except) {
          select.classList.remove("is-open");
          select.querySelector("button")?.setAttribute("aria-expanded", "false");
        }
      });
    };

    selects.forEach((select) => {
      const button = select.querySelector<HTMLButtonElement>("button");
      const label = select.querySelector<HTMLElement>("[data-select-label]");
      if (!button || !label) return;

      button.addEventListener("click", (event) => {
        event.stopPropagation();
        const open = !select.classList.contains("is-open");
        closeAll(select);
        select.classList.toggle("is-open", open);
        button.setAttribute("aria-expanded", open ? "true" : "false");
      });

      select.querySelectorAll<HTMLElement>("li[role='option']").forEach((option) => {
        option.addEventListener("click", (event) => {
          event.stopPropagation();
          if (option.getAttribute("aria-disabled") === "true") return;
          select
            .querySelectorAll("li[role='option']")
            .forEach((li) => li.setAttribute("aria-selected", li === option ? "true" : "false"));
          label.textContent = option.getAttribute("data-value") ?? option.textContent;
          closeAll();
        });
      });
    });

    document.addEventListener("click", () => closeAll());
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeAll();
    });
  })();

  // ── Sidebar: collapsed on the stacked layout ────────────────────
  (() => {
    const acc = document.querySelector<HTMLDetailsElement>("[data-side-acc]");
    if (!acc) return;

    const narrow = window.matchMedia("(max-width: 880px)");
    // Ships open so the links are there without JS; closed here as soon as we
    // know the layout is stacked, and re-opened if the viewport widens back.
    const sync = () => {
      acc.open = !narrow.matches;
    };
    sync();
    narrow.addEventListener("change", sync);

    // Filtering a list you cannot see is filtering nothing — typing in the
    // search box opens the menu it filters.
    document
      .querySelector<HTMLInputElement>("[data-docs-search]")
      ?.addEventListener("input", (event) => {
        if ((event.target as HTMLInputElement).value.trim()) acc.open = true;
      });
  })();

  // ── Sidebar filter (search box) ─────────────────────────────────
  (() => {
    const input = document.querySelector<HTMLInputElement>("[data-docs-search]");
    const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-side-group]"));
    const empty = document.querySelector<HTMLElement>("[data-side-empty]");
    if (!input || !groups.length) return;

    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let any = false;
      groups.forEach((group) => {
        let visible = 0;
        group.querySelectorAll<HTMLAnchorElement>("[data-side-link]").forEach((link) => {
          const hit = !q || (link.textContent ?? "").toLowerCase().includes(q);
          link.style.display = hit ? "" : "none";
          if (hit) visible += 1;
        });
        group.style.display = visible ? "" : "none";
        if (visible) any = true;
      });
      if (empty) empty.hidden = any;
    };

    input.addEventListener("input", apply);
    input.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        input.value = "";
        apply();
        input.blur();
      }
    });

    document.addEventListener("keydown", (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        input.focus();
      }
    });
  })();

  // ── "On this page": built from the headings the page actually has ──
  // Each docs route is its own document now, so the rail lists in-page
  // headings rather than the sections of one long scroll.
  (() => {
    const list = document.querySelector<HTMLElement>("[data-toc-list]");
    const main = document.querySelector<HTMLElement>(".lpd-main");
    const rail = document.querySelector<HTMLElement>(".lpd-toc");
    if (!list || !main) return;

    const headings = Array.from(main.querySelectorAll<HTMLElement>("h2[id], h3[id]"));
    if (headings.length < 2) {
      // A rail listing one item is noise; hide it and let the prose have the room.
      rail?.setAttribute("hidden", "");
      return;
    }

    const links = headings.map((heading) => {
      const link = document.createElement("a");
      link.href = `#${heading.id}`;
      link.textContent = heading.textContent ?? "";
      link.dataset.target = heading.id;
      if (heading.tagName === "H3") link.classList.add("lpd-toc-sub");
      list.appendChild(link);
      return link;
    });

    const setActive = (id: string) =>
      links.forEach((link) => link.classList.toggle("is-active", link.dataset.target === id));

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin: "-25% 0px -65% 0px", threshold: 0 },
    );
    headings.forEach((heading) => observer.observe(heading));
    setActive(headings[0].id);
  })();
</script>
